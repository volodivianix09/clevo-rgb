<Window x:Class="ClevoRgbLite.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свой цвет"
        Width="450" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#2E3542" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Свой цвет" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Настройте оттенок ползунками или введите HEX-код."
                       Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border x:Name="ColorPreview" Grid.Row="1" Height="86" CornerRadius="12"
                Background="#0066FF" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,18,0,0" />

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="HEX" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="HexBox" Grid.Column="1" MaxLength="7" TextChanged="HexBox_TextChanged" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Красный" />
                <TextBlock x:Name="RValue" Grid.Column="1" Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold" />
            </Grid>
            <Slider x:Name="RSlider" Style="{StaticResource AppSliderStyle}"
                    Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="RgbSlider_Changed" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Зелёный" />
                <TextBlock x:Name="GValue" Grid.Column="1" Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold" />
            </Grid>
            <Slider x:Name="GSlider" Style="{StaticResource AppSliderStyle}"
                    Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="RgbSlider_Changed" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Синий" />
                <TextBlock x:Name="BValue" Grid.Column="1" Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold" />
            </Grid>
            <Slider x:Name="BSlider" Style="{StaticResource AppSliderStyle}"
                    Minimum="0" Maximum="255" TickFrequency="1" ValueChanged="RgbSlider_Changed" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0" Click="Cancel_Click" />
            <Button Content="Готово" Style="{StaticResource PrimaryButtonStyle}" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
